# MolEdit — files that should not be committed to the public repository

# Local Chrome profile / caches used by the CDP test harness
.chrome-profile/
.chrome-profile-*/

# Development screenshots and debug output (README images live in docs/)
shots/

# Generated E2E report (contains machine-specific paths; regenerate with: node tests/e2e.mjs)
tests/e2e-report.json

# Windows shortcut files (generated by tools/create-shortcut.ps1)
*.lnk

# Node / Python tooling
node_modules/
__pycache__/
*.pyc

# OS / editor cruft
Thumbs.db
desktop.ini
.DS_Store
*.swp
