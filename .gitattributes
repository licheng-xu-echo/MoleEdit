# Normalize line endings in the repository (stored as LF in git).
* text=auto

# Launchers / sources: LF so they run on Linux and macOS
*.sh      text eol=lf
*.command text eol=lf
*.mjs     text eol=lf
*.js      text eol=lf
*.md      text eol=lf
*.xyz     text eol=lf
*.sdf     text eol=lf
*.gjf     text eol=lf
*.log     text eol=lf

# Windows-only scripts: check out with CRLF
*.bat     text eol=crlf
*.ps1     text eol=crlf
*.vbs     text eol=crlf

# Binary assets
*.png binary
*.ico binary
